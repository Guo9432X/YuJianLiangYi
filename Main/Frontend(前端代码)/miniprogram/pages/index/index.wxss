/**index.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  box-sizing: border-box;
}
/* 背景容器不变 */
.bg-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -999; /* 改这里！把背景压到最底层 */
  overflow: hidden;
  pointer-events: none; /* 加这行！禁止背景拦截点击 */
}
.bg-swiper {
  width: 100%;
  height: 100%;
}
/* 背景图铺满 */
.bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 蒙版不变 */
.bg-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.55);
  z-index: 3;
  pointer-events: none; /* 加这行 */
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.userinfo-avatar {
  overflow: hidden;
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}
.art-text-css {
  font-size: 60rpx;
  font-weight: bold;
  text-align: center;
  padding: 0 0 20rpx;
  
  /* 炫酷的渐变色 */
  background: linear-gradient(to bottom, #ffffff, #a8ff78); 
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  
  /* 加上一点发光阴影，让它在背景上更跳跃 */
  text-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
  
  letter-spacing: 4rpx; /* 字间距 */
  font-style: normal;   /* 斜体增加动感 */
}



.userinfo-nickname {
  margin-top: 50rpx;
  color: #fff;
}

.usermotto {
  margin-top: 100rpx;
  margin-bottom: 60rpx;
}

/* 以下只新增，不覆盖原有 */
.login-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  
}
.login-btn {
  width: 320rpx;
  background-color: #07c160;
  color: #fff;
  margin: 10rpx 0;
}
.guest-btn {
  width: 320rpx;
  background-color: #fff;
  color: #666;
  margin: 10rpx 0;
}

input.userinfo-nickname {
  text-align: center;
  font-size: 30rpx;
}
/* 新增：头像按钮样式 */
.avatar-btn {
  /* 清除默认背景和边框 */
  background: transparent;
  border: none;
  /* 清除默认内边距，让图片完全贴合 */
  padding: 0;
  margin: 0;
  /* 让按钮和图片大小一致 */
  width: 128rpx;
  height: 128rpx;
  /* 让内部图片居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  /* 清除按钮点击时的默认边框 */
  outline: none;
}

/* 可选：去掉按钮的圆角（如果有默认圆角的话） */
.avatar-btn::after {
  border-radius: 0;
}
